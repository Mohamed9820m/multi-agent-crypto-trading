# Binance API (Testnet strongly recommended for development)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here
BINANCE_USE_TESTNET=true

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=trader
DB_PASSWORD=trader
DB_NAME=crypto_trading
DATABASE_URL=postgresql://trader:trader@localhost:5432/crypto_trading

# Message bus (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Trading configuration
TRADING_SYMBOL=BTCUSDT
TRADING_TIMEFRAME=1h
TRADING_MODE=paper           # paper | testnet | live
CYCLE_INTERVAL_MS=300000     # 5 minutes
MAX_DAILY_LOSS_PCT=3.0       # hard daily loss limit
RISK_PER_TRADE_PCT=1.0       # fixed fractional risk per trade
MIN_CONFIDENCE=60            # minimum Strategy Fusion confidence
MIN_RISK_REWARD=1.5          # minimum take-profit / stop-loss ratio
MAX_CONCURRENT_POSITIONS=2
MAX_CORRELATION_CAP=0.8
ACCOUNT_EQUITY_FLOOR_EUR=25  # Guardian absolute floor
MAX_TRADES_PER_DAY=10        # Guardian runaway-loop limit
STARTING_CAPITAL_EUR=50      # Paper/testnet fallback capital

# Strategy selection (see src/strategies/playbook.ts)
ACTIVE_STRATEGY=trendFollowing

# Futures only (ignored in spot)
USE_FUTURES=false
MAX_LEVERAGE=2

# Logging
LOG_LEVEL=info

# External AI (OpenAI for research AI / CLAWBOT)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CLAWBOT mode: internal | url | off
CLAWBOT_MODE=internal
# CLAWBOT_URL=
# CLAWBOT_API_KEY=

# On-chain / institutional intelligence (optional)
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
GOPLUS_ENABLED=true
# TENDERLY_ACCOUNT=
# TENDERLY_PROJECT=
# TENDERLY_API_KEY=
# COINGLASS_API_KEY=
# ARKHAM_API_KEY=
# BUBBLEMAPS_API_KEY=

# Hybrid CeFi / DeFi execution (optional — disabled by default)
DEX_ENABLED=false
# ETH_PRIVATE_KEY=0x...
# ONEINCH_API_KEY=
# FLASHBOTS_RELAY_URL=https://relay.flashbots.net
# BLOXROUTE_AUTH_HEADER=
# JITO_AUTH_HEADER=
